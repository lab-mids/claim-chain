zhuang2017:A5.1 a mp:Statement ;
	claimchain:assumption_basis "AUTHOR_CHOICE" ;
	claimchain:open_question "Structures that need a reconstructive transformation away from hcp (such as Mg17Al12) cannot be found by the search." ;
	claimchain:paper_part "METHODS" ;
	claimchain:statement_type "ASSUMPTION" ;
	claimchain:text "The hcp parent lattice is an appropriate constraint for identifying Mg-rich precipitate structures." .
zhuang2017:A5.2 a mp:Statement ;
	claimchain:assumption_basis "AUTHOR_CHOICE" ;
	claimchain:open_question "KSDFT and OFDFT disagree on the D0_19 vs L1_2 ordering, so few-meV differences from the cluster expansion may not be reliable." ;
	claimchain:paper_part "METHODS" ;
	claimchain:statement_type "ASSUMPTION" ;
	claimchain:text "OFDFT relative configurational energies are accurate enough to train the cluster expansion used for screening." .
