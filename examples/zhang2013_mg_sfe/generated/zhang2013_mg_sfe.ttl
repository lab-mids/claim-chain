doi:10.1016\/j.commatsci.2013.07.012 dcterms:creator "G. Liu" , "J. Zhang" , "Y. Dou" , "Z. Guo" ;
	dcterms:title "First-principles study of stacking fault energies in Mg-based binary alloys" ;
	a schema1:ScholarlyArticle ;
	claimchain:doi "10.1016/j.commatsci.2013.07.012" ;
	claimchain:year 2013 .
zhang2013:AIM1 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 6" ;
	claimchain:statement_type "AIM" ;
	claimchain:text "The paper computes the I1 stacking fault energy of 52 binary Mg-X systems." .
zhang2013:AIM2 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 6" ;
	claimchain:statement_type "AIM" ;
	claimchain:text "The paper uses a periodic supercell with two fault interfaces, so that no vacuum layer and no free surface is needed." .
zhang2013:AIM3 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 6" ;
	claimchain:statement_type "AIM" ;
	claimchain:text "The paper tests the convergence of the stacking fault energy with supercell size." .
zhang2013:AIM4 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 6" ;
	claimchain:statement_type "AIM" ;
	claimchain:text "The paper computes each solute at two concentrations on the fault plane, 11 and 25 at.%." .
zhang2013:AIM5 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 6" ;
	claimchain:statement_type "AIM" ;
	claimchain:text "The paper explains the trends of the stacking fault energy with simple physical features of the solute atoms." .
zhang2013:AIM6 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 6" ;
	claimchain:statement_type "AIM" ;
	claimchain:text "The stacking fault energies form a first-principles database meant to guide the design of formable magnesium alloys." .
zhang2013:BG1 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Magnesium alloys are the lightest structural metals, but wrought magnesium products such as sheets and extrusions are still rare." .
zhang2013:BG2 a mp:Statement ;
	claimchain:evidence _:c14n2 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Hcp magnesium has only two independent basal slip systems while compatible polycrystal deformation needs five, so non-basal slip and twinning must be activated to make magnesium formable." .
zhang2013:BG3 a mp:Statement ;
	claimchain:evidence _:c14n14 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 2" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Stacking fault energy governs the deformation behaviour of metals, and solute atoms change it by disturbing the local charge density and strain field." .
zhang2013:BG4 a mp:Statement ;
	claimchain:about ent:I1 ;
	claimchain:evidence _:c14n10 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 3" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Studies of Mg-Y, Mg-Zn-Y and Mg-Li or Mg-Al link solute-induced changes of the I1 stacking fault energy to the active deformation modes and to ductility." .
zhang2013:BG5 a mp:Statement ;
	claimchain:evidence _:c14n20 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 4" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Measured stacking fault energies of magnesium scatter between 50 and 280 mJ/m2, whereas DFT values for pure magnesium lie between 8 and 21 mJ/m2." .
zhang2013:CLAIM10 a mp:Statement ;
	claimchain:assessment _:c14n8 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "CORRELATIONAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:paper_part "CONCLUSION" ;
	claimchain:section "Sec. 5, sentence 6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Solutes with lower ionization energy and larger radius decrease the stacking fault energy, and those with higher ionization energy and smaller radius increase it." .
zhang2013:CLAIM11 a mp:Statement ;
	claimchain:assessment _:c14n3 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:paper_part "CONCLUSION" ;
	claimchain:section "Sec. 5, sentences 7-9" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The effect of a solute usually grows with concentration, but most rare earths change the stacking fault energy non-monotonically." .
zhang2013:CLAIM12 a mp:Statement ;
	claimchain:assessment _:c14n4 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:concerns _:c14n6 ;
	claimchain:paper_part "CONCLUSION" ;
	claimchain:section "Sec. 5, final sentence" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The abnormal concentration dependence of the stacking fault energy is correlated with quantum tunnelling." .
zhang2013:CLAIM1 a mp:Statement ;
	claimchain:assessment _:c14n12 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "METHODOLOGICAL" ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 3.1" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The two-fault supercell gives converged stacking fault energies that agree with published DFT values, and the two cells used for alloys give nearly the same pure-magnesium value." .
zhang2013:CLAIM2 a mp:Statement ;
	claimchain:assessment _:c14n31 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:concerns _:c14n27 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 3.2, Table 2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Table 2 is a first-principles database of the I1 stacking fault energy for 52 solutes at two concentrations, which divides the solutes into raisers and lowerers." .
zhang2013:CLAIM3 a mp:Statement ;
	claimchain:assessment _:c14n16 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "CORRELATIONAL" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:concerns _:c14n18 , _:c14n52 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.1, final paragraph" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Solutes with a low first ionization energy and a large atomic radius lower the I1 stacking fault energy of magnesium, and solutes with a high ionization energy and a small radius raise it." .
zhang2013:CLAIM4 a mp:Statement ;
	claimchain:assessment _:c14n41 ;
	claimchain:author_certainty "PROPOSED" ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:claim_role "MECHANISTIC_INTERPRETATION" ;
	claimchain:concerns _:c14n38 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.1, para. 5-6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "A solute with a high ionization energy forms a local potential well that gathers charge near the fault, so forming the fault needs more charge redistribution and the stacking fault energy rises." .
zhang2013:CLAIM5 a mp:Statement ;
	claimchain:assessment _:c14n43 ;
	claimchain:author_certainty "PROPOSED" ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:claim_role "MECHANISTIC_INTERPRETATION" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.1, para. 7" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Large solutes lower the stacking fault energy because they expand the lattice locally, which favours the wider fcc-like zone at the fault." .
zhang2013:CLAIM6 a mp:Statement ;
	claimchain:assessment _:c14n35 ;
	claimchain:author_certainty "SPECULATIVE" ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:claim_role "MECHANISTIC_INTERPRETATION" ;
	claimchain:evidence _:c14n49 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.2, final paragraph" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The reversal at 25 at.% arises because electrons tunnel between neighbouring solutes above about 20 at.%, which weakens the local potential wells and hills; the authors say this needs further verification." .
zhang2013:CLAIM7 a mp:Statement ;
	claimchain:assessment _:c14n5 ;
	claimchain:author_certainty "PROPOSED" ;
	claimchain:claim_modality "GENERALIZATION" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 3.2, 4.2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The SFE rule and the rare-earth trend give a screening rule for magnesium alloy design, and Yb and Bi additions or a rare-earth optimum are worth testing experimentally." .
zhang2013:CLAIM8 a mp:Statement ;
	claimchain:assessment _:c14n34 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:paper_part "CONCLUSION" ;
	claimchain:section "Sec. 5, sentences 1-3" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Convergence of the supercells was tested strictly and is satisfactory for the 2x2x10 cell." .
zhang2013:CLAIM9 a mp:Statement ;
	claimchain:assessment _:c14n39 ;
	claimchain:author_certainty "DEMONSTRATED" ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:paper_part "CONCLUSION" ;
	claimchain:section "Sec. 5, sentences 4-5" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Cobalt and cesium bracket the range of stacking fault energies; eighteen solutes raise it and most, including every rare earth, lower it." .
zhang2013:GAP1 a mp:Statement ;
	claimchain:evidence _:c14n45 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 5" ;
	claimchain:statement_type "GAP" ;
	claimchain:text "The I1 stacking fault energy has been computed for only eight solutes in magnesium (Al, Dy, Gd, Li, Nd, Pr, Tb, Y)." .
zhang2013:GAP2 a mp:Statement ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1, para. 5" ;
	claimchain:statement_type "GAP" ;
	claimchain:text "Earlier DFT calculations of the I1 fault used vacuum layers whose free surfaces may interact with the fault, and rarely tested convergence with supercell size." .
zhang2013:GAP3 a mp:Statement ;
	claimchain:note "Not stated in the paper; inferred by Sepideh from the contribution of two concentrations (an implicit gap)." ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1 (implicit)" ;
	claimchain:statement_type "GAP" ;
	claimchain:text "Earlier calculations of solute effects on the I1 fault used a single solute concentration." .
zhang2013:LIM1 a mp:Statement ;
	claimchain:limitation_kind "INTERPRETATION" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "LIMITATION" ;
	claimchain:text "The tunnelling explanation of the concentration reversal is preliminary and needs further verification." .
zhang2013:METH1 a mp:Statement ;
	claimchain:about ent:DFT ;
	claimchain:concerns _:c14n15 , _:c14n54 , _:c14n7 ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 2, para. 1" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "Energies are computed with VASP using PAW potentials and the PBE functional, relaxing atoms with Methfessel-Paxton smearing until forces are below 0.01 eV/A and taking final energies with the tetrahedron method." .
zhang2013:METH2 a mp:Statement ;
	claimchain:about ent:I1 , ent:SFE ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 2, para. 2-3, Fig. 1, Eq. (1)" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "The I1 fault is built by switching the stacking from AB to CB halfway along c in a periodic supercell, which then contains two fault interfaces, and the stacking fault energy is (E - E0) / 2A." .
zhang2013:METH3 a mp:Statement ;
	claimchain:about ent:MgX ;
	claimchain:concerns _:c14n24 ;
	claimchain:evidence _:c14n44 ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 2, para. 4, Fig. 2" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "One magnesium atom in the faulted layer of a 2x2x10 or a 3x3x10 supercell is replaced by a solute, giving 25 or 11 at.% on the fault plane, which the paper states as 2.5 and 1.1 at.% overall." .
zhang2013:OBS10 a mp:Statement ;
	claimchain:note "Derived by Sepideh from the cell geometry; not stated in the paper." ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.2 (annotator)" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "In the 2x2x10 cell each solute is about 6.4 A, two lattice spacings, from its own periodic image." .
zhang2013:OBS1 a mp:Statement ;
	claimchain:about ent:Mg , ent:SFE ;
	claimchain:evidence _:c14n42 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:scope _:c14n51 ;
	claimchain:section "Sec. 3.1, Table 1, Fig. 3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "The pure-magnesium stacking fault energy stops changing once the supercell has at least 10 unit cells along c, at 17.9-21.4 mJ/m2, within the published DFT range, and the 2x2x10 and 3x3x10 cells give 21.0 and 21.4 mJ/m2." .
zhang2013:OBS2 a mp:Statement ;
	claimchain:about ent:MgX , ent:SFE ;
	claimchain:concerns _:c14n9 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 3.2, Table 2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Eighteen of the 52 solutes raise the I1 stacking fault energy, cobalt most with 34.8 and 54.1 mJ/m2 at 11 and 25 at.%." .
zhang2013:OBS3 a mp:Statement ;
	claimchain:about ent:MgX , ent:SFE ;
	claimchain:concerns _:c14n47 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 3.2, Table 2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Most solutes lower the I1 stacking fault energy, including every rare earth; cesium lowers it most, to -33.3 mJ/m2 at 25 at.%, and nine solutes give a negative value." .
zhang2013:OBS4 a mp:Statement ;
	claimchain:concerns _:c14n37 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 3.2, Table 2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Differences below about 1 mJ/m2 from pure magnesium, e.g. Mo 21.6 and Rh 21.3 against 21.0 mJ/m2, are counted as increases of the stacking fault energy." .
zhang2013:OBS5 a mp:Statement ;
	claimchain:about ent:Ei ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.1, Fig. 4" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "At 11 at.%, almost every solute that lowers the stacking fault energy has a lower first ionization energy than magnesium, but ten solutes (Ag, Cr, Li, Mn, Mo, Nb, Ni, Rh, Ru, V) have a lower ionization energy and still raise it." .
zhang2013:OBS6 a mp:Statement ;
	claimchain:about ent:radius ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.1, Fig. 5" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Virtually every solute that raises the stacking fault energy is smaller than magnesium (160 pm), including all ten exceptions to the ionization-energy trend (124-152 pm)." .
zhang2013:OBS7 a mp:Statement ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:scope _:c14n22 ;
	claimchain:section "Sec. 4.1, Fig. 6" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Charge-density plots show cobalt gathering electrons and cesium pushing them away near the faulted plane." .
zhang2013:OBS8 a mp:Statement ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 2, para. 2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "After relaxation the interplanar distance in the fcc-like zone at the fault is 5.178 A, slightly larger than the 5.165 A of the perfect lattice." .
zhang2013:OBS9 a mp:Statement ;
	claimchain:note "A result reported in the discussion; Sepideh maps it to the results (location and function differ)." ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.2, Fig. 7" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "For most solutes the change of the stacking fault energy grows from 11 to 25 at.% (Ga 19.0 to 3.3 mJ/m2), but for 23 solutes it moves back toward pure magnesium (Er 5.6 to 10.2 mJ/m2), including all rare earths except La, Ce, Pr, Nd and Yb." .
zhang2013:OUT1 a mp:Statement ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "OUTLOOK" ;
	claimchain:text "Yb and Bi may raise the stacking-fault density, and rare-earth content should be optimised rather than maximised." .
