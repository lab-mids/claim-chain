arxiv:2606.09611v1 dcterms:creator "J.C. Stinville" , "Jiayang Wang" , "Marat I. Latypov" , "Mathieu Calvat" ;
	dcterms:title "Lattice genome: representation and analysis of heterogeneous crystalline microstructures" ;
	a schema1:ScholarlyArticle ;
	claimchain:arxiv "2606.09611v1" ;
	claimchain:year 2026 .
wang2026:ASM1 a mp:Statement ;
	claimchain:assumption_basis "AUTHOR_CHOICE" ;
	claimchain:evidence _:c14n81 ;
	claimchain:open_question "Does a fixed percentile assume a fixed fraction of boundary pixel pairs in every map?" ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 3" ;
	claimchain:statement_type "ASSUMPTION" ;
	claimchain:text "Absolute latent-space thresholds do not transfer between microstructures, so A* and D* are set to the p-th percentile of each map's own A and D distributions." .
wang2026:ASM2 a mp:Statement ;
	claimchain:assumption_basis "COMMUNITY_ACCEPTED" ;
	claimchain:concerns _:c14n40 ;
	claimchain:evidence _:c14n29 ;
	claimchain:hedged true ;
	claimchain:open_question "Does the WCSS elbow coincide with physically meaningful boundaries, or only with a statistical knee?" ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 3" ;
	claimchain:statement_type "ASSUMPTION" ;
	claimchain:text "The elbow of the within-cluster sum of squares vs. number-of-clusters curve corresponds to the optimal microstructure segmentation." .
wang2026:ASM3 a mp:Statement ;
	claimchain:assumption_basis "COMMUNITY_ACCEPTED" ;
	claimchain:evidence _:c14n68 ;
	claimchain:open_question "Which of the extra latent domains are real boundaries the 5 degree reference misses, and which are artifacts?" ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "ASSUMPTION" ;
	claimchain:text "Grain maps from 5 degree misorientation thresholding are an adequate reference for judging a microstructure segmentation." .
wang2026:ASM4 a mp:Statement ;
	claimchain:assumption_basis "COMMUNITY_ACCEPTED" ;
	claimchain:evidence _:c14n103 ;
	claimchain:open_question "If KLVS differs from KAM, which one is closer to the true defect content?" ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "ASSUMPTION" ;
	claimchain:text "KAM and GOS are accepted measures of local and grain-level microstructural heterogeneity, so agreement with them indicates a meaningful heterogeneity metric." .
wang2026:BG1 a mp:Statement ;
	claimchain:about ent:MaterialsGene ;
	claimchain:evidence _:c14n39 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "The Materials Genome Initiative assumes materials have an underlying code dictating behaviour, but what a materials gene looks like in practice remains unclear." .
wang2026:BG2 a mp:Statement ;
	claimchain:about ent:MaterialsGene ;
	claimchain:evidence _:c14n59 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "A generalized materials gene should be a vector that is compact, unique, experimentally accessible, and has a distance metric reflecting structural similarity." .
wang2026:BG3 a mp:Statement ;
	claimchain:evidence _:c14n47 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Atomic pair distribution functions meet the gene criteria for uniform materials but lack spatial information at the mesoscale." .
wang2026:BG4 a mp:Statement ;
	claimchain:evidence _:c14n43 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "In structural alloys, spatial heterogeneity of phases, orientations and defects governs macroscale properties." .
wang2026:BG5 a mp:Statement ;
	claimchain:about ent:EBSD , ent:KikuchiPattern ;
	claimchain:evidence _:c14n44 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "EBSD maps Kikuchi patterns over large areas at the mesoscale with high automation and speed." .
wang2026:BG6 a mp:Statement ;
	claimchain:about ent:EBSD , ent:KikuchiPattern ;
	claimchain:evidence _:c14n27 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Conventional EBSD reduces Kikuchi patterns to individual lossy descriptors (phase, orientation, rotation, strain, dislocation densities); combining them does not recover all pattern information." .
wang2026:BG7 a mp:Statement ;
	claimchain:evidence _:c14n54 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Prior PCA, matrix-factorization and deep-learning approaches to Kikuchi patterns compress them or extract known features, but do not give a holistic compact encoding." .
wang2026:BG8 a mp:Statement ;
	claimchain:about ent:KikuchiPattern , ent:VAE ;
	claimchain:evidence _:c14n51 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "A VAE trained on Kikuchi patterns compresses each pattern into a latent vector from which the pattern can be reconstructed to a predefined accuracy." .
wang2026:BG9 a mp:Statement ;
	claimchain:evidence _:c14n17 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:scope _:c14n91 ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "BACKGROUND" ;
	claimchain:text "Spatial maps of VAE latent features of Kikuchi patterns reveal microstructural heterogeneities with sensitivity exceeding conventional EBSD analysis." .
wang2026:CLAIM10 a mp:Statement ;
	claimchain:assessment _:c14n79 ;
	claimchain:claim_modality "CONCEPTUAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:evidence _:c14n28 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "One encoded lattice genome can serve many downstream tasks without reprocessing raw patterns." .
wang2026:CLAIM1a a mp:Statement ;
	claimchain:about ent:LatticeGene ;
	claimchain:assessment _:c14n73 ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:concerns _:c14n50 ;
	claimchain:evidence _:c14n64 ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The VAE latent vector of a Kikuchi pattern is a compact, low-dimensional representation of the pattern." .
wang2026:CLAIM1b a mp:Statement ;
	claimchain:about ent:LatticeGene ;
	claimchain:assessment _:c14n77 ;
	claimchain:claim_modality "DESCRIPTIVE" ;
	claimchain:claim_role "METHODOLOGICAL" ;
	claimchain:evidence _:c14n106 ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "With a pretrained encoder, the latent vector is obtained from a measured pattern by a single forward pass, so it is experimentally accessible." .
wang2026:CLAIM1c a mp:Statement ;
	claimchain:about ent:LatticeGene ;
	claimchain:assessment _:c14n86 ;
	claimchain:claim_modality "CORRELATIONAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:concerns _:c14n109 , _:c14n70 ;
	claimchain:evidence _:c14n112 ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Distance between latent vectors of Kikuchi patterns reflects the physical similarity of the probed lattice (crystallography, orientation, defects), and the continuous latent space avoids discontinuities of space-group classification." .
wang2026:CLAIM1d a mp:Statement ;
	claimchain:about ent:LatticeGene ;
	claimchain:assessment _:c14n10 ;
	claimchain:claim_modality "CONCEPTUAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:concerns _:c14n94 ;
	claimchain:evidence _:c14n100 , _:c14n2 ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Because the Kikuchi pattern can be reconstructed from it, the latent vector encodes lattice parameter, orientation, strain and defect density, and maps near-uniquely to the local lattice state within reconstruction error." .
wang2026:CLAIM2 a mp:Statement ;
	claimchain:about ent:LatticeGenome , ent:MaterialsGene ;
	claimchain:assessment _:c14n57 ;
	claimchain:claim_modality "CONCEPTUAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:evidence _:c14n53 ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "The lattice genome extends the materials genome concept to heterogeneous crystalline materials at the mesoscale." .
wang2026:CLAIM3 a mp:Statement ;
	claimchain:about ent:LatticeGenome , ent:PCA ;
	claimchain:assessment _:c14n93 ;
	claimchain:claim_modality "COMPARATIVE" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:paper_part "RESULTS" ;
	claimchain:scope _:c14n89 ;
	claimchain:section "Sec. 4.1, 6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "PCA-based latent component maps are an analog of orientation maps that reveal finer microstructural heterogeneity than IPF maps." .
wang2026:CLAIM4 a mp:Statement ;
	claimchain:about ent:GrainSegmentation , ent:LatticeGenome ;
	claimchain:assessment _:c14n82 ;
	claimchain:claim_modality "COMPARATIVE" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:concerns _:c14n66 , _:c14n75 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:scope _:c14n78 ;
	claimchain:section "Sec. 4.2, 6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Segmentation by latent angle and distance thresholds produces domain maps consistent with misorientation grain maps while being more sensitive." .
wang2026:CLAIM5 a mp:Statement ;
	claimchain:assessment _:c14n110 ;
	claimchain:claim_modality "GENERALIZATION" ;
	claimchain:claim_role "METHODOLOGICAL" ;
	claimchain:concerns _:c14n99 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:scope _:c14n97 ;
	claimchain:section "Sec. 5, Suppl." ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "A single percentile parameter with automatic elbow detection produces suitable segmentations across microstructures with very different statistics, without case-by-case calibration." .
wang2026:CLAIM6 a mp:Statement ;
	claimchain:about ent:KAM , ent:KLVS ;
	claimchain:assessment _:c14n72 ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:concerns _:c14n114 , _:c14n48 ;
	claimchain:evidence _:c14n9 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3, 6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "KLVS reproduces KAM trends with better contrast for real features and fewer artifacts, because it operates on the encoded pattern rather than on indexed orientations." .
wang2026:CLAIM7 a mp:Statement ;
	claimchain:about ent:GOS , ent:LVS ;
	claimchain:assessment _:c14n26 ;
	claimchain:claim_modality "COMPARATIVE" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:concerns _:c14n41 , _:c14n8 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3, 6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "LVS is a high-dimensional analog of GOS that recovers qualitatively similar trends of grain-level heterogeneity." .
wang2026:CLAIM8 a mp:Statement ;
	claimchain:assessment _:c14n38 ;
	claimchain:claim_modality "CORRELATIONAL" ;
	claimchain:claim_role "INTERMEDIATE" ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Angle and Euclidean distance in the latent space are consistent descriptors of local microstructural variation." .
wang2026:CLAIM9 a mp:Statement ;
	claimchain:assessment _:c14n92 ;
	claimchain:claim_modality "GENERALIZATION" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:concerns _:c14n104 ;
	claimchain:evidence _:c14n108 , _:c14n62 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5, 6" ;
	claimchain:statement_type mp:Claim ;
	claimchain:text "Lattice-genome analysis needs no pattern indexing and is therefore applicable to patterns that are hard to index, such as heavily deformed or multiphase regions." .
wang2026:DATA1 a mp:Statement ;
	claimchain:paper_part "RESULTS" ;
	claimchain:scope _:c14n42 ;
	claimchain:section "Sec. 4" ;
	claimchain:statement_type "DATA" ;
	claimchain:text "Three EBSD maps with raw Kikuchi patterns are analysed, all from Calvat et al. - wrought fully recrystallized IN718 (RX), partially recrystallized Waspaloy (W), and as-built DED IN718 (AM)." .
wang2026:DEF1 a mp:Statement ;
	claimchain:about ent:LatticeGene ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type "DEFINITION" ;
	claimchain:text "A lattice gene is the latent encoding z_i in R^d of a single Kikuchi pattern." .
wang2026:DEF2 a mp:Statement ;
	claimchain:about ent:LatticeGenome ;
	claimchain:concerns _:c14n67 ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type "DEFINITION" ;
	claimchain:text "A lattice genome is the spatially resolved collection of lattice genes, Z in R^(HxWxd), over a statistically representative area or volume of a material in a given state." .
wang2026:GAP1 a mp:Statement ;
	claimchain:about ent:MaterialsGene ;
	claimchain:evidence _:c14n49 ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "GAP" ;
	claimchain:text "No notion of materials genes exists for spatially heterogeneous materials at the mesoscale." .
wang2026:HYP1 a mp:Statement ;
	claimchain:about ent:LatticeGene , ent:LatticeGenome ;
	claimchain:assessment _:c14n3 ;
	claimchain:claim_modality "CONCEPTUAL" ;
	claimchain:claim_role "MAIN_CONCLUSION" ;
	claimchain:paper_part "INTRODUCTION" ;
	claimchain:section "Sec. 1" ;
	claimchain:statement_type "HYPOTHESIS" ;
	claimchain:text "VAE latent representations of Kikuchi patterns satisfy the criteria for a generalized materials gene, which extends the materials genome to heterogeneous crystalline materials, and they support standard microstructure analysis." .
wang2026:LIM1 a mp:Statement ;
	claimchain:limitation_kind "SCOPE" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "LIMITATION" ;
	claimchain:text "Latent component map colours are dataset-dependent because PCA is fitted per map, unlike the universal IPF colour scheme." .
wang2026:LIM2 a mp:Statement ;
	claimchain:evidence _:c14n84 ;
	claimchain:limitation_kind "METHOD" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "LIMITATION" ;
	claimchain:text "Crystal symmetry is encoded only implicitly in lattice genes; latent angles are not symmetry-reduced, so KLVS and LVS are systematically larger than KAM and GOS and do not match them quantitatively." .
wang2026:LIM3 a mp:Statement ;
	claimchain:evidence _:c14n56 ;
	claimchain:limitation_kind "DATA" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "LIMITATION" ;
	claimchain:text "Lattice genes also encode measurement conditions (detector geometry, pattern centre, background, noise), complicating comparisons across datasets." .
wang2026:LIM4 a mp:Statement ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:evidence _:c14n111 ;
	claimchain:limitation_kind "INTERPRETATION" ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "LIMITATION" ;
	claimchain:text "Where the interaction volume spans several lattices, e.g. at grain or twin boundaries, the lattice gene encodes a superposition, which is harder to interpret but makes the encoding sensitive to overlaps." .
wang2026:METH1 a mp:Statement ;
	claimchain:about ent:VAE ;
	claimchain:evidence _:c14n69 ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 3, 4" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "Kikuchi patterns are encoded with the pretrained VAE encoder of Calvat et al.; one of 128 latent dimensions is dropped because it mainly captures measurement geometry, giving d = 127." .
wang2026:METH2 a mp:Statement ;
	claimchain:about ent:PCA ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 3, 4.1" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "Latent component maps are built by PCA of all lattice genes of one map and mapping PC1-3 to RGB; optionally each latent dimension is first rescaled so its 1st and 99th percentiles map to 0 and 1." .
wang2026:METH3 a mp:Statement ;
	claimchain:concerns _:c14n90 ;
	claimchain:evidence _:c14n16 ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 3" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "Neighbouring pixels are merged into one domain if both the latent angle A and the latent Euclidean distance D are below thresholds A* and D*, scanning row by row over right and down neighbours; domains under 6 pixels are dismissed." .
wang2026:METH4 a mp:Statement ;
	claimchain:concerns _:c14n33 ;
	claimchain:evidence _:c14n14 ;
	claimchain:paper_part "METHODS" ;
	claimchain:section "Sec. 3, Suppl." ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "The percentile p is scanned from 95 to 60 in steps of 1 and the search stops when three consecutive relative WCSS reductions fall below 10 % of the mean of the first eight; p* is the middle of that window." .
wang2026:METH5 a mp:Statement ;
	claimchain:about ent:KLVS ;
	claimchain:concerns _:c14n0 ;
	claimchain:evidence _:c14n63 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "Kernel latent vector spread (KLVS) of a pixel is the mean latent angle between its lattice gene and those of its nearest neighbours." .
wang2026:METH6 a mp:Statement ;
	claimchain:about ent:LVS ;
	claimchain:concerns _:c14n35 ;
	claimchain:evidence _:c14n31 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "METHOD" ;
	claimchain:text "Latent vector spread (LVS) of a domain is the mean latent angle between each pixel's lattice gene and the domain centroid." .
wang2026:OBS10 a mp:Statement ;
	claimchain:evidence _:c14n1 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Area distributions of latent domains and misorientation grains closely match for RX and W but not for AM." .
wang2026:OBS11 a mp:Statement ;
	claimchain:about ent:KAM , ent:KLVS ;
	claimchain:evidence _:c14n34 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "KLVS and KAM maps show the same qualitative trends - high values at boundaries in RX, elevated values throughout W, and patches in AM." .
wang2026:OBS12 a mp:Statement ;
	claimchain:about ent:KAM , ent:KLVS ;
	claimchain:evidence _:c14n101 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "High-KAM artifacts from poorly indexed grains (RX) and a polishing scratch (W) are absent or weaker in KLVS maps." .
wang2026:OBS13 a mp:Statement ;
	claimchain:evidence _:c14n60 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "KLVS resolves intragranular substructure in large AM grains that is not visible in KAM." .
wang2026:OBS14 a mp:Statement ;
	claimchain:evidence _:c14n118 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "KLVS values span 0-120 degrees whereas KAM spans 0-8 degrees, so absolute values are not comparable." .
wang2026:OBS15 a mp:Statement ;
	claimchain:evidence _:c14n58 ;
	claimchain:paper_part "SUPPLEMENTARY" ;
	claimchain:section "Suppl." ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Distance-based KLVS maps are similar to angle-based KLVS maps." .
wang2026:OBS16 a mp:Statement ;
	claimchain:about ent:GOS , ent:LVS ;
	claimchain:evidence _:c14n96 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "LVS maps show the same trends as GOS maps - low in RX, high in W, intermediate in AM." .
wang2026:OBS17 a mp:Statement ;
	claimchain:evidence _:c14n61 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.3" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Area-weighted LVS and GOS distributions differ, most strongly for AM; for RX and W they show similar but shifted peaks." .
wang2026:OBS1 a mp:Statement ;
	claimchain:evidence _:c14n18 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:scope _:c14n87 ;
	claimchain:section "Sec. 4.1" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "In the three maps, the first three principal components of the lattice genes explain 25-37 % of the variance, and about 20 components are needed to explain nearly 100 %." .
wang2026:OBS2 a mp:Statement ;
	claimchain:evidence _:c14n21 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:scope _:c14n85 ;
	claimchain:section "Sec. 4.1" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Latent component maps capture the grain-scale heterogeneity seen in IPF orientation maps in all three microstructure states." .
wang2026:OBS3 a mp:Statement ;
	claimchain:claim_modality "CAUSAL" ;
	claimchain:concerns _:c14n98 ;
	claimchain:evidence _:c14n76 ;
	claimchain:hedged true ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.1" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Latent component maps show features faint or absent in IPF maps - preparation deformation and an extra grain (RX), smooth intragranular gradients likely from orientation variation (W), and substructure likely from dislocation cells (AM)." .
wang2026:OBS4 a mp:Statement ;
	claimchain:evidence _:c14n55 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.1" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Pre-PCA per-dimension scaling reveals an annealing twin and intragranular gradients missed by unscaled latent component maps and otherwise visible only in single-dimension maps." .
wang2026:OBS5 a mp:Statement ;
	claimchain:evidence _:c14n116 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.1" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "In a 2D PCA projection, lattice genes form visible clusters, most clearly for the RX microstructure." .
wang2026:OBS6 a mp:Statement ;
	claimchain:evidence _:c14n30 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "The early-stopping search selects percentile thresholds p76 (RX), p80 (W) and p73 (AM)." .
wang2026:OBS7 a mp:Statement ;
	claimchain:concerns _:c14n71 ;
	claimchain:evidence _:c14n6 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Latent domain boundaries largely coincide with grain boundaries from 5 degree misorientation thresholding, most closely for RX and W." .
wang2026:OBS8 a mp:Statement ;
	claimchain:evidence _:c14n113 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Latent segmentation yields more domains than misorientation segmentation yields grains in all three microstructures." .
wang2026:OBS9 a mp:Statement ;
	claimchain:evidence _:c14n36 ;
	claimchain:paper_part "RESULTS" ;
	claimchain:section "Sec. 4.2" ;
	claimchain:statement_type "OBSERVATION" ;
	claimchain:text "Latent segmentation misses some grain boundaries - those of small grains in AM and W, those near poorly indexed regions in RX, and a few regular grain boundaries." .
wang2026:OUT1 a mp:Statement ;
	claimchain:evidence _:c14n115 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "OUTLOOK" ;
	claimchain:text "Rotation-invariant or conditional, disentangling encoders could make symmetry explicit and separate physical quantities in the latent space." .
wang2026:OUT2 a mp:Statement ;
	claimchain:evidence _:c14n117 ;
	claimchain:hedged true ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "OUTLOOK" ;
	claimchain:text "Training on large, diverse diffraction datasets can yield a unique, instrument-invariant encoding with a universal distance metric." .
wang2026:OUT3 a mp:Statement ;
	claimchain:evidence _:c14n20 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5, 6" ;
	claimchain:statement_type "OUTLOOK" ;
	claimchain:text "The lattice-genome analysis tools are encoder-agnostic and will remain applicable as encoder architectures evolve." .
wang2026:OUT4 a mp:Statement ;
	claimchain:evidence _:c14n22 ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "OUTLOOK" ;
	claimchain:text "Lattice genomes can be extended to chord-length and n-point statistics, multiphase materials, EDS coupling and machine-learning property prediction." .
wang2026:OUT5 a mp:Statement ;
	claimchain:hedged true ;
	claimchain:paper_part "DISCUSSION" ;
	claimchain:section "Sec. 5" ;
	claimchain:statement_type "OUTLOOK" ;
	claimchain:text "The lattice genome may offer a practical realization of the Materials Genome Initiative vision for heterogeneous crystalline materials at the mesoscale." .
wang2026:Q1 a mp:Statement ;
	claimchain:paper_part "THEORY" ;
	claimchain:section "Sec. 2" ;
	claimchain:statement_type "QUESTION" ;
	claimchain:text "Can the lattice genome support visualization, segmentation and heterogeneity quantification as done in conventional EBSD workflows?" .
