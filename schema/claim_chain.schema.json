{
    "$defs": {
        "ArgumentChain": {
            "additionalProperties": false,
            "description": "The full encoded argument of one publication.",
            "properties": {
                "annotation_date": {
                    "format": "date",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "annotator": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cited_works": {
                    "items": {
                        "$ref": "#/$defs/CitedWork"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "entities": {
                    "items": {
                        "$ref": "#/$defs/Entity"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "id": {
                    "type": "string"
                },
                "paper_assessment": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PaperAssessment"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "publication": {
                    "$ref": "#/$defs/Publication"
                },
                "relations": {
                    "items": {
                        "$ref": "#/$defs/Relation"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "schema_version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "statements": {
                    "items": {
                        "$ref": "#/$defs/Statement"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "publication"
            ],
            "title": "ArgumentChain",
            "type": "object"
        },
        "AssertionSource": {
            "description": "",
            "enum": [
                "AUTHORS",
                "ANNOTATOR",
                "ANNOTATOR_BACKGROUND"
            ],
            "title": "AssertionSource",
            "type": "string"
        },
        "Assessment": {
            "additionalProperties": false,
            "description": "Verdict on one claim or hypothesis: does the data presented in the paper support it?",
            "properties": {
                "criteria": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Criteria"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "missing_evidence": {
                    "description": "Data or analysis that would be needed to support the statement.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "proof_obligations": {
                    "items": {
                        "$ref": "#/$defs/ProofObligation"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "rationale": {
                    "type": "string"
                },
                "validity": {
                    "$ref": "#/$defs/Validity"
                }
            },
            "required": [
                "validity",
                "rationale"
            ],
            "title": "Assessment",
            "type": "object"
        },
        "AssumptionBasis": {
            "description": "",
            "enum": [
                "COMMUNITY_ACCEPTED",
                "AUTHOR_CHOICE"
            ],
            "title": "AssumptionBasis",
            "type": "string"
        },
        "AuthorCertainty": {
            "description": "",
            "enum": [
                "DEMONSTRATED",
                "PREDICTED",
                "PROPOSED",
                "SPECULATIVE"
            ],
            "title": "AuthorCertainty",
            "type": "string"
        },
        "CitedWork": {
            "additionalProperties": false,
            "description": "A reference of the paper and why the argument cites it. References are not looked up; `cited_for` records what the reference is assumed to provide.",
            "properties": {
                "citation": {
                    "description": "Short bibliographic string, e.g. \"Mouhat & Coudert, PRB 90, 224104 (2014)\".",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cited_for": {
                    "description": "What the argument assumes the reference provides, e.g. \"Born stability criteria\".",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "id": {
                    "type": "string"
                },
                "number": {
                    "description": "The reference's number or label in the paper's bibliography.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id"
            ],
            "title": "CitedWork",
            "type": "object"
        },
        "ClaimModality": {
            "description": "",
            "enum": [
                "DESCRIPTIVE",
                "COMPARATIVE",
                "CORRELATIONAL",
                "CAUSAL",
                "GENERALIZATION",
                "CONCEPTUAL"
            ],
            "title": "ClaimModality",
            "type": "string"
        },
        "ClaimRole": {
            "description": "",
            "enum": [
                "MAIN_CONCLUSION",
                "INTERMEDIATE",
                "QUANTITATIVE_SUPPORT",
                "MECHANISTIC_INTERPRETATION",
                "METHODOLOGICAL",
                "COUNTER_CLAIM"
            ],
            "title": "ClaimRole",
            "type": "string"
        },
        "Concern": {
            "additionalProperties": false,
            "description": "An annotator's (not the authors') remark on a logical weakness.",
            "properties": {
                "concern_type": {
                    "$ref": "#/$defs/ConcernType"
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "concern_type"
            ],
            "title": "Concern",
            "type": "object"
        },
        "ConcernType": {
            "description": "",
            "enum": [
                "UNTESTED_ASSERTION",
                "OVERCLAIM",
                "UNFALSIFIABLE_VALIDATION",
                "CONFOUNDED_COMPARISON",
                "AD_HOC_PARAMETER",
                "MISSING_QUANTIFICATION",
                "OVERGENERALIZATION",
                "UNACKNOWLEDGED_CONFLICT",
                "UNADDRESSED_COUNTEREVIDENCE",
                "INTERNAL_INCONSISTENCY",
                "REPRODUCIBILITY",
                "CAUSAL_OVERREACH"
            ],
            "title": "ConcernType",
            "type": "string"
        },
        "Criteria": {
            "additionalProperties": false,
            "description": "Draft rubric (v0.5 proposal): six questions answered separately for one claim. Each answer is MET, PARTLY, NOT_MET or NOT_APPLICABLE. render.py derives a graded score (mean of MET=1, PARTLY=0.5, NOT_MET=0 over the applicable criteria) and a suggested verdict, and reports where the suggested verdict differs from `validity`.",
            "properties": {
                "alternatives_excluded": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CriterionValue"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Obvious alternative explanations or confounders are excluded by a control or an argument. NOT_APPLICABLE for purely descriptive claims."
                },
                "consistent": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CriterionValue"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Nothing in the paper's own data or statements contradicts the claim."
                },
                "criteria_note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "grounded": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CriterionValue"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The claim rests on data, a derivation or citations that the paper presents, not on assertion alone."
                },
                "inference_sound": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CriterionValue"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The step from evidence to claim uses an established rule or one argued in the paper; empirical rules of thumb or unstated rules give PARTLY or NOT_MET."
                },
                "quantified": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CriterionValue"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Quantitative or comparative claims come with numbers, uncertainties or sample counts that make the difference meaningful. NOT_APPLICABLE for qualitative claims."
                },
                "scope_matches": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CriterionValue"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The evidence covers the claim as worded (materials, conditions, number of samples, generality, \"optimal\", \"any\")."
                }
            },
            "title": "Criteria",
            "type": "object"
        },
        "CriterionValue": {
            "description": "",
            "enum": [
                "MET",
                "PARTLY",
                "NOT_MET",
                "NOT_APPLICABLE"
            ],
            "title": "CriterionValue",
            "type": "string"
        },
        "DerivedCheck": {
            "additionalProperties": false,
            "description": "A number or criterion computed from the evidence values, so that a claim can be checked by recomputing instead of by reading. If `formula` is given, scripts/render.py evaluates it from the `symbol`s of the evidence values and compares the outcome with `result` or `satisfied`.",
            "properties": {
                "expression": {
                    "description": "Human-readable form of the check, e.g. \"2 C13^2 < C33 (C11 + C12)\".",
                    "type": "string"
                },
                "formula": {
                    "description": "Machine-evaluable arithmetic over the value symbols, Python syntax (+ - * / ** abs min max, comparisons), e.g. \"2*C13**2 < C33*(C11+C12)\".",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "result": {
                    "description": "Reported numeric outcome of the formula.",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "satisfied": {
                    "description": "Reported outcome of a criterion (a formula with a comparison).",
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "unit": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "expression"
            ],
            "title": "DerivedCheck",
            "type": "object"
        },
        "Entity": {
            "additionalProperties": false,
            "description": "A thing statements are about (material, technique, quantity, method, concept), defined once per paper so statements and scopes can refer to it.",
            "properties": {
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "entity_type": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EntityType"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "label"
            ],
            "title": "Entity",
            "type": "object"
        },
        "EntityType": {
            "description": "",
            "enum": [
                "MATERIAL",
                "PROCESSING_STATE",
                "TECHNIQUE",
                "DATA_TYPE",
                "QUANTITY",
                "METHOD",
                "CONCEPT"
            ],
            "title": "EntityType",
            "type": "string"
        },
        "Evidence": {
            "additionalProperties": false,
            "description": "What the paper offers in support of a statement.",
            "properties": {
                "derived_checks": {
                    "items": {
                        "$ref": "#/$defs/DerivedCheck"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "evidence_kind": {
                    "$ref": "#/$defs/EvidenceKind"
                },
                "locator": {
                    "description": "Figure, table, equation or section, e.g. \"Fig. 5a\".",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "references": {
                    "description": "Reference numbers or DOIs cited as evidence.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "values": {
                    "items": {
                        "$ref": "#/$defs/QuantitativeValue"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "evidence_kind"
            ],
            "title": "Evidence",
            "type": "object"
        },
        "EvidenceKind": {
            "description": "",
            "enum": [
                "CITATION",
                "ARGUMENT",
                "DATA_QUALITATIVE",
                "DATA_QUANTITATIVE",
                "NONE"
            ],
            "title": "EvidenceKind",
            "type": "string"
        },
        "LimitationKind": {
            "description": "",
            "enum": [
                "SCOPE",
                "METHOD",
                "DATA",
                "INTERPRETATION",
                "INCONSISTENCY"
            ],
            "title": "LimitationKind",
            "type": "string"
        },
        "ObligationStatus": {
            "description": "",
            "enum": [
                "OPEN",
                "PARTIALLY_DISCHARGED",
                "DISCHARGED"
            ],
            "title": "ObligationStatus",
            "type": "string"
        },
        "PaperAssessment": {
            "additionalProperties": false,
            "description": "Paper-level result with the three outputs: logic (verdict and score), limitations, and missing evidence.",
            "properties": {
                "key_limitations": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "logic_score": {
                    "description": "Computed by scripts/render.py from the claim verdicts; see score_method.",
                    "maximum": 1,
                    "minimum": 0,
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "missing_evidence": {
                    "description": "Data or analysis that would be needed to support the statement.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "obligation_coverage": {
                    "description": "Share of proof obligations discharged (PARTIALLY_DISCHARGED counts half).",
                    "maximum": 1,
                    "minimum": 0,
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "overall_validity": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Validity"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "score_method": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "summary": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "weighted_logic_score": {
                    "description": "Logic score weighted by claim_role; computed by scripts/render.py.",
                    "maximum": 1,
                    "minimum": 0,
                    "type": [
                        "number",
                        "null"
                    ]
                }
            },
            "title": "PaperAssessment",
            "type": "object"
        },
        "PaperPart": {
            "description": "",
            "enum": [
                "ABSTRACT",
                "INTRODUCTION",
                "THEORY",
                "METHODS",
                "RESULTS",
                "DISCUSSION",
                "CONCLUSION",
                "SUPPLEMENTARY"
            ],
            "title": "PaperPart",
            "type": "string"
        },
        "Priority": {
            "description": "",
            "enum": [
                "CRITICAL",
                "HIGH",
                "MEDIUM",
                "LOW"
            ],
            "title": "Priority",
            "type": "string"
        },
        "ProofObligation": {
            "additionalProperties": false,
            "description": "Something that has to be shown for a claim to hold (reviewer's view). Open obligations are what a reviewer would ask for.",
            "properties": {
                "discharged_by": {
                    "description": "Ids of statements that (partly) discharge the obligation.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "obligation_status": {
                    "$ref": "#/$defs/ObligationStatus"
                },
                "priority": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Priority"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "How much the argument depends on an open question or obligation."
                },
                "requested_data": {
                    "items": {
                        "$ref": "#/$defs/RequestedData"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "text": {
                    "type": "string"
                }
            },
            "required": [
                "text",
                "obligation_status"
            ],
            "title": "ProofObligation",
            "type": "object"
        },
        "Publication": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "arxiv": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "authors": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "url": {
                    "format": "uri",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "year": {
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "id"
            ],
            "title": "Publication",
            "type": "object"
        },
        "QuantitativeValue": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "condition": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "quantity": {
                    "type": "string"
                },
                "symbol": {
                    "description": "Short identifier for the value, usable in DerivedCheck formulas (e.g. C11, BG_Mg). Letters, digits and underscores; unique within one Evidence.",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "unit": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "value": {
                    "type": "number"
                }
            },
            "required": [
                "quantity",
                "value"
            ],
            "title": "QuantitativeValue",
            "type": "object"
        },
        "Relation": {
            "additionalProperties": false,
            "description": "A directed, typed link between two statements.",
            "properties": {
                "asserted_by": {
                    "$ref": "#/$defs/AssertionSource"
                },
                "id": {
                    "type": "string"
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "object": {
                    "description": "Id of a Statement (or, for ANALOG_OF, an Entity).",
                    "type": "string"
                },
                "predicate": {
                    "$ref": "#/$defs/RelationType"
                },
                "subject": {
                    "description": "Id of a Statement (or, for ANALOG_OF, an Entity).",
                    "type": "string"
                },
                "support_basis": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/SupportBasis"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "How the subject supports the object (qualitative, quantitative, logical)."
                },
                "support_strength": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/SupportStrength"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "How strongly the subject supports the object."
                },
                "uncertainty": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Uncertainty"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Qualitative uncertainty of the link itself."
                },
                "warrant": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Warrant"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "On a Relation: why the subject supports the object. On a Statement: why the statement's own evidence supports it."
                }
            },
            "required": [
                "id",
                "subject",
                "predicate",
                "object",
                "asserted_by"
            ],
            "title": "Relation",
            "type": "object"
        },
        "RelationType": {
            "description": "",
            "enum": [
                "SUPPORTS",
                "UNDERCUTS",
                "CONTRADICTS",
                "QUALIFIES",
                "ALTERNATIVE_EXPLANATION_FOR",
                "MOTIVATES",
                "ANSWERS",
                "DEPENDS_ON",
                "ANALOG_OF",
                "CONDITIONALLY_SUPPORTS"
            ],
            "title": "RelationType",
            "type": "string"
        },
        "RequestedData": {
            "additionalProperties": false,
            "description": "A measurement or calculation that would discharge a proof obligation.",
            "properties": {
                "method": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "quantity": {
                    "type": "string"
                },
                "unit": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "quantity"
            ],
            "title": "RequestedData",
            "type": "object"
        },
        "Scope": {
            "additionalProperties": false,
            "description": "Conditions under which a statement was shown to hold.",
            "properties": {
                "crystal_structures": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "materials": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "sample_count": {
                    "description": "Number of independent samples or datasets.",
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "scope_note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "techniques": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "Scope",
            "type": "object"
        },
        "Statement": {
            "additionalProperties": false,
            "description": "One self-contained proposition, phrased so it is understandable on its own (no pronouns pointing to other statements).",
            "properties": {
                "about": {
                    "description": "Entities this statement is about.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "assessment": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Assessment"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Validity verdict; expected for every CLAIM and HYPOTHESIS."
                },
                "assumption_basis": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/AssumptionBasis"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "For ASSUMPTION statements, where the premise comes from."
                },
                "author_certainty": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/AuthorCertainty"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "How certain the authors themselves present the statement. This is the authors' stance; the annotator's verdict goes in `assessment`."
                },
                "claim_modality": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ClaimModality"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "What kind of statement a claim or observation makes, e.g. correlational vs. causal."
                },
                "claim_role": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ClaimRole"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Role of a claim or hypothesis in the paper's argument; used to weight the logic score."
                },
                "concerns": {
                    "items": {
                        "$ref": "#/$defs/Concern"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "evidence": {
                    "items": {
